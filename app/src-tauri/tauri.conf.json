{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palmi PasswordVault",
  "version": "1.0.0",
  "identifier": "com.palmid3v.passwordvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Palmi PasswordVault",
        "width": 1280,
        "height": 820,
        "minWidth": 950,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}